# WhatsApp MCP settings. Copy to .env (make install does this for you).
# Read by both the bridge and the MCP server. After editing, run:
#   make restart     (bridge)
# and restart Claude Code / Claude Desktop (MCP server).

# Sending and group admin. Off = read-only: Claude can read and summarise,
# but the send/group tools don't exist and the bridge refuses writes.
WHATSAPP_MCP_ALLOW_WRITE=false

# Optional: only allow writes to these chats. Comma-separated phone numbers
# (with country code) or JIDs, e.g. 84901234567,120363000000000000@g.us
# Empty = no restriction (once writing is on).
WHATSAPP_MCP_SEND_ALLOWLIST=

# Optional: only send files from this folder.
WHATSAPP_MCP_MEDIA_DIR=
